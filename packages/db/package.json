    "db:import-smoke": "tsx scripts/import-smoke.ts",
    "db:storage-quota-smoke": "tsx scripts/storage-quota-smoke.ts",
    "db:storage-integrity-smoke": "tsx scripts/storage-integrity-smoke.ts",
