{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Process liveness probe (not DB readiness)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/system/capabilities": {
      "get": {
        "operationId": "CapabilitiesController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityPageDto"
                }
              }
            }
          }
        },
        "summary": "Truthful V1 feature availability (never implies mock APIs are active)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "ReadinessController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Database readiness (503 when unavailable)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/me/onboarding": {
      "get": {
        "operationId": "OnboardingController_read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userId",
                    "stage",
                    "locale",
                    "interests",
                    "version"
                  ],
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "welcome",
                        "language",
                        "interests",
                        "complete"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "tr",
                        "en"
                      ]
                    },
                    "interests": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Read only the verified bearer owner onboarding snapshot",
        "tags": [
          "account"
        ],
        "security": [
          {
            "folioSession": []
          }
        ]
      },
      "patch": {
        "operationId": "OnboardingController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expectedVersion",
                  "stage",
                  "locale",
                  "interests"
                ],
                "properties": {
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483646
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "welcome",
                      "language",
                      "interests",
                      "complete"
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "tr",
                      "en"
                    ]
                  },
                  "interests": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 20,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userId",
                    "stage",
                    "locale",
                    "interests",
                    "version"
                  ],
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "welcome",
                        "language",
                        "interests",
                        "complete"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "tr",
                        "en"
                      ]
                    },
                    "interests": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Update the verified bearer owner onboarding with optimistic version",
        "tags": [
          "account"
        ],
        "security": [
          {
            "folioSession": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "Folio API",
    "description": "Folio versioned REST API. Capabilities reflect the actual lab status.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CapabilityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "reader"
          },
          "available": {
            "type": "boolean",
            "example": false
          },
          "note": {
            "type": "string",
            "example": "Not implemented in this lab build"
          }
        },
        "required": [
          "id",
          "available",
          "note"
        ]
      },
      "CapabilityPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    },
    "securitySchemes": {
      "folioSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    }
  }
}
