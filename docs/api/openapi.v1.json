{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Process liveness probe (not DB readiness)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/system/capabilities": {
      "get": {
        "operationId": "CapabilitiesController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityPageDto"
                }
              }
            }
          }
        },
        "summary": "Truthful V1 feature availability (never implies mock APIs are active)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "ReadinessController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Database readiness (503 when unavailable)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/me/onboarding": {
      "get": {
        "operationId": "OnboardingController_read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userId",
                    "stage",
                    "locale",
                    "interests",
                    "version"
                  ],
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "welcome",
                        "language",
                        "interests",
                        "complete"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "tr",
                        "en"
                      ]
                    },
                    "interests": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "folioSession": []
          }
        ],
        "summary": "Read only the verified bearer owner onboarding snapshot",
        "tags": [
          "account"
        ]
      },
      "patch": {
        "operationId": "OnboardingController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expectedVersion",
                  "stage",
                  "locale",
                  "interests"
                ],
                "properties": {
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483646
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "welcome",
                      "language",
                      "interests",
                      "complete"
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "tr",
                      "en"
                    ]
                  },
                  "interests": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 20,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userId",
                    "stage",
                    "locale",
                    "interests",
                    "version"
                  ],
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "stage": {
                      "type": "string",
                      "enum": [
                        "welcome",
                        "language",
                        "interests",
                        "complete"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "tr",
                        "en"
                      ]
                    },
                    "interests": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "folioSession": []
          }
        ],
        "summary": "Update the verified bearer owner onboarding with optimistic version",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/me/sessions": {
      "get": {
        "operationId": "DeviceSessionsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "deviceLabel",
                          "createdAt",
                          "expiresAt",
                          "isCurrent"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "deviceLabel": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "expiresAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "isCurrent": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "folioSession": []
          }
        ],
        "summary": "List verified account active devices without bearer tokens",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/me/sessions/{sessionId}": {
      "delete": {
        "operationId": "DeviceSessionsController_revoke",
        "parameters": [
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "folioSession": []
          }
        ],
        "summary": "Revoke one owned device session; repeat revocation is idempotent",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/auth/web/login": {
      "post": {
        "operationId": "WebAuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Gated direct-TLS only web login (disabled unless explicitly configured)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/web/csrf": {
      "get": {
        "operationId": "WebAuthController_csrf",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Bootstrap HMAC CSRF header for a verified HTTPS web cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/web/logout": {
      "post": {
        "operationId": "WebAuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "CSRF-protected logout for exactly the current web device",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Folio API",
    "description": "Folio versioned REST API. Capabilities reflect the actual lab status.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "folioSession": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "CapabilityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "reader"
          },
          "available": {
            "type": "boolean",
            "example": false
          },
          "note": {
            "type": "string",
            "example": "Not implemented in this lab build"
          }
        },
        "required": [
          "id",
          "available",
          "note"
        ]
      },
      "CapabilityPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    }
  }
}
