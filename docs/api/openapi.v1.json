{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Process liveness probe (not DB readiness)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/system/capabilities": {
      "get": {
        "operationId": "CapabilitiesController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityPageDto"
                }
              }
            }
          }
        },
        "summary": "Truthful V1 feature availability (never implies mock APIs are active)",
        "tags": [
          "system"
        ]
      }
    }
  },
  "info": {
    "title": "Folio API",
    "description": "Folio versioned REST API. Capabilities reflect the actual lab status.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CapabilityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "reader"
          },
          "available": {
            "type": "boolean",
            "example": false
          },
          "note": {
            "type": "string",
            "example": "Not implemented in this lab build"
          }
        },
        "required": [
          "id",
          "available",
          "note"
        ]
      },
      "CapabilityPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    }
  }
}
