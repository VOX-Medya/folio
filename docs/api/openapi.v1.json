  "components": {
    "securitySchemes": {
      "folioSession": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      },
      "folioWebSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-folio_session"
      }
    },
    "schemas": {
      "CapabilityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "reader"
          },
          "available": {
            "type": "boolean",
            "example": false
          },
          "note": {
            "type": "string",
            "example": "Not implemented in this lab build"
          }
        },
        "required": [
          "id",
          "available",
          "note"
        ]
      },
      "CapabilityPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    }
  }
