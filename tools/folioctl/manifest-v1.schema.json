{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "string",
      "const": "local-editorial"
    },
    "scope": {
      "type": "string",
      "const": "licensed-library"
    },
    "declared_counts": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "works": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "editions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "authors",
        "works",
        "editions",
        "revisions"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "files": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          },
          "kind": {
            "type": "string",
            "enum": [
              "metadata",
              "text",
              "alignment",
              "audio",
              "asset"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "created_at",
    "source",
    "scope",
    "declared_counts",
    "tool",
    "files"
  ],
  "additionalProperties": false
}
