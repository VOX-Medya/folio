{
  "name": "@folio/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run src",
    "openapi:write": "tsx scripts/export-openapi.ts",
    "openapi:check": "tsx scripts/export-openapi.ts --check",
    "auth:http-smoke": "tsx src/scripts/auth-http-smoke.ts",
    "auth:admission-http-smoke": "tsx src/scripts/auth-admission-http-smoke.ts",
    "onboarding:http-smoke": "tsx src/scripts/onboarding-http-smoke.ts",
    "device-sessions:http-smoke": "tsx src/scripts/device-sessions-http-smoke.ts",
    "web-cookie:https-smoke": "tsx src/scripts/web-cookie-https-smoke.ts",
    "web-auth:https-smoke": "tsx src/scripts/web-auth-https-smoke.ts",
    "web-self:https-smoke": "tsx src/scripts/web-self-https-smoke.ts",
    "admin-totp:https-smoke": "tsx src/scripts/admin-totp-https-smoke.ts",
    "admin-catalog:https-smoke": "tsx src/scripts/admin-catalog-https-smoke.ts"
  },
  "dependencies": {
    "@folio/contracts": "workspace:*",
    "@folio/db": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
