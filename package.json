{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm --filter @folio/contracts build && pnpm --filter @folio/db build && pnpm typecheck && pnpm test && pnpm build && pnpm design:check && pnpm --filter @folio/server openapi:check",
    "e2e": "playwright test",
    "design:check": "node tools/design/generate-screen-matrix.mjs --check",
    "mobile:export": "pnpm --filter @folio/mobile exec expo export --platform all && node tools/ci/check-expo-exports.mjs",
    "ci:contract-test": "node --test tools/ci/*.test.mjs tools/design/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.29"
    }
  }
}
