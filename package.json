{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm --filter @folio/contracts build && pnpm --filter @folio/db build && pnpm typecheck && pnpm test && pnpm build && pnpm design:check && pnpm --filter @folio/server openapi:check",
    "e2e": "playwright test",
    "design:check": "node tools/design/generate-screen-matrix.mjs --check",
    "mobile:export": "pnpm --filter @folio/mobile exec expo export --platform all && node tools/ci/check-expo-exports.mjs",
    "ci:contract-test": "node --test tools/ci/*.test.mjs tools/design/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.29",
      "metro": "0.83.8",
      "metro-babel-transformer": "0.83.8",
      "metro-cache": "0.83.8",
      "metro-cache-key": "0.83.8",
      "metro-config": "0.83.8",
      "metro-core": "0.83.8",
      "metro-file-map": "0.83.8",
      "metro-minify-terser": "0.83.8",
      "metro-resolver": "0.83.8",
      "metro-runtime": "0.83.8",
      "metro-source-map": "0.83.8",
      "metro-symbolicate": "0.83.8",
      "metro-transform-plugins": "0.83.8",
      "metro-transform-worker": "0.83.8"
    }
  }
}
